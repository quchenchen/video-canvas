# 根目录运行时配置
.env

# 后端构建产物与运行时数据
/backend/bin/
/backend/tmp/
/backend/**/*.exe
/backend/data/
/backend/logs/
/backend/configs/*.local.yaml

# Agent 运行时（Node）依赖和构建产物
/agent/node_modules/
/agent/dist/

# 前端依赖与构建产物
/web/node_modules/
/web/dist/
/web/.env.local

# IDE
/.idea/
/.vscode/
/backend/.idea/
/backend/.vscode/
/web/.idea/
/web/.vscode/

# Agent 运行观测的本地数据（含用户原文，禁止提交）
.traces/

.claude/worktrees/

# 本地主密钥（生产同步，含真实凭据，永不入库）
/backend/.ai-secret-key.local

# 项目记忆与本地工作区数据
/.workbuddy/
